            "label": "Fetched Count"
        },
        {
            "fieldname": "created_count",
            "fieldtype": "Int",
            "label": "Created Count"
        },
        {
            "fieldname": "duplicate_count",
            "fieldtype": "Int",
            "label": "Duplicate Count"
        },
        {
            "fieldname": "unmapped_count",
            "fieldtype": "Int",
            "label": "Unmapped Count"
        },
        {
            "fieldname": "error_count",
            "fieldtype": "Int",
            "label": "Error Count"
