{
    "doctype": "DocType",
    "name": "Biometric Sync Log",
    "module": "ESSL Attendance",
    "custom": 1,
    "fields": [
        {
            "fieldname": "device",
            "fieldtype": "Link",
            "label": "Device",
            "options": "Biometric Device"
        },
        {
            "fieldname": "status",
            "fieldtype": "Select",
            "label": "Status",
            "options": "Started\nSuccess\nPartial Success\nFailed"
        },
        {
            "fieldname": "start_time",
            "fieldtype": "Datetime",
            "label": "Start Time"
        },
        {
            "fieldname": "end_time",
            "fieldtype": "Datetime",
            "label": "End Time"
        },
        {
            "fieldname": "fetched_count",
